// js/services/api-manager.js
import apiFootballService from './api-football-service.js';

export class APIManager {
    async getMatchDataForPrediction(fixtureId, homeTeamId, awayTeamId) {
        console.log(`📡 Récupération des données pour le match ID: ${fixtureId}...`);

        // Appel parallèle pour optimiser le temps de réponse
        const [h2h, odds] = await Promise.all([
            apiFootballService.getH2H(homeTeamId, awayTeamId),
            apiFootballService.getMatchOdds(fixtureId)
        ]);

        return {
            h2hData: h2h,
            oddsData: odds
        };
    }
}

export default new APIManager();
